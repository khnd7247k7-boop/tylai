{
  "name": "tyl-ai-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --clear --host lan",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "bash scripts/sync-gemini-proxy-env.sh && expo run:ios --device 00008120-000251D62E68201E --no-bundler",
    "web": "expo start --web",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev",
    "db:bootstrap": "bash scripts/bootstrap-usda-sqlite.sh",
    "maestro:test": "maestro test .maestro",
    "maestro:smoke": "maestro test .maestro/flows/smoke.yaml",
    "maestro:ci": "maestro test .maestro --format junit --output maestro-report.xml",
    "maestro:tags": "maestro test .maestro --include-tags=smoke",
    "gemini-proxy:sync": "bash scripts/sync-gemini-proxy-env.sh",
    "gemini-proxy:serve": "cd gemini-proxy && npm start",
    "gemini-proxy": "bash scripts/sync-gemini-proxy-env.sh && npm run gemini-proxy:serve",
    "dev": "bash scripts/dev-up.sh",
    "dev:tunnel": "bash scripts/dev-tunnel.sh",
    "dev-up": "npm run dev",
    "phone:url": "bash scripts/print-phone-url.sh",
    "phone": "bash scripts/sync-gemini-proxy-env.sh && expo run:ios --device 00008120-000251D62E68201E --no-bundler",
    "api:setup": "bash scripts/sync-gemini-proxy-env.sh && npm run db:bootstrap",
    "eas:init": "eas init",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:submit:ios": "eas submit --platform ios --profile production --latest",
    "eas:secrets": "bash scripts/sync-eas-secrets.sh",
    "preflight:testflight": "bash scripts/preflight-testflight.sh",
    "deploy:proxy": "bash scripts/deploy-gemini-proxy.sh",
    "testflight": "eas build --platform ios --profile production && eas submit --platform ios --profile production --latest",
    "testflight:setup": "bash scripts/testflight-eas.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@google/generative-ai": "^0.21.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@shopify/flash-list": "2.0.2",
    "axios": "^1.15.2",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.22",
    "expo-haptics": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^11.8.1",
    "lodash": "^4.18.1",
    "lucide-react-native": "^1.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-quick-sqlite": "^8.2.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/lodash": "^4.17.24",
    "@types/react": "~19.1.0",
    "concurrently": "^9.2.1",
    "eas-cli": "^16.0.0",
    "wrangler": "^4.69.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "private": true
}
