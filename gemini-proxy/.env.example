# Required: server-side Gemini key (never expose this in frontend code)
GEMINI_KEY=your_google_ai_studio_or_gcp_key
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional
# GEMINI_MODEL=gemini-2.5-flash
# NUTRITIONIX_APP_ID=
# NUTRITIONIX_API_KEY=
# Optional — get a free key at https://fdc.nal.usda.gov/api-key-signup.html
# USDA_FDC_API_KEY=your_usda_fdc_api_key
# PORT=8080
