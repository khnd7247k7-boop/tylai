# CANONICAL PROJECT PATH (use this folder in Cursor — not ~/Desktop/tyl-ai-app on iCloud):
#   /Users/travispixton/Code/tyl-ai-app-local
# Open: tyl-ai-app.code-workspace  |  Start dev: npm run dev  (proxy + Expo, one terminal)
#
# Production proxy URL (required for TestFlight / App Store builds)
# EXPO_PUBLIC_GEMINI_PROXY_URL=https://api.tyl-ai.com
#
# Server-only keys (never EXPO_PUBLIC_*): GEMINI_KEY, USDA_FDC_API_KEY, NUTRITIONIX_* in gemini-proxy/.env
# Sync copies them from here via: npm run gemini-proxy:sync
GEMINI_KEY=your_google_ai_studio_or_gcp_key
USDA_FDC_API_KEY=your_usda_fdc_api_key
#
# Dev fallback: direct Gemini from the app (not for production)
# EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_key
#
# Optional: force a model id if defaults fail (e.g. gemini-2.5-flash)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
#
# Dev only: grant Premium tier without a purchase (never enable in production builds)
EXPO_PUBLIC_GRANT_PREMIUM=true

# Optional: grant Premium only for specific Firebase login emails (works on TestFlight too)
# EXPO_PUBLIC_DEVELOPER_PREMIUM_EMAILS=you@example.com,teammate@example.com

# Firebase web config (used by React Native Firebase JS SDK in this app)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_web_app_id
