# Used by Xcode script phases (Bundle React Native, etc.).
# Xcode does not load your shell profile, so node/nvm must be resolved here.

if [[ -z "${NODE_BINARY:-}" ]]; then
  if [[ -x "/usr/local/bin/node" ]]; then
    export NODE_BINARY="/usr/local/bin/node"
  elif [[ -x "/opt/homebrew/bin/node" ]]; then
    export NODE_BINARY="/opt/homebrew/bin/node"
  elif [[ -f "$HOME/.nvm/nvm.sh" ]]; then
    export NVM_DIR="$HOME/.nvm"
    # shellcheck source=/dev/null
    . "$HOME/.nvm/nvm.sh" --no-use
    export NODE_BINARY="$(command -v node)"
  else
    export NODE_BINARY="$(command -v node)"
  fi
fi

if [[ -z "${NODE_BINARY:-}" || ! -x "${NODE_BINARY}" ]]; then
  echo "error: NODE_BINARY is not set. Install Node or create ios/.xcode.env.local with:" >&2
  echo '  export NODE_BINARY="/path/to/node"' >&2
  exit 1
fi
